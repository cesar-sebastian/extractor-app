# Local only. These values match docker-compose.yml.
# The app connects as extractor_app. Migrations connect as extractor.
DATABASE_URL=postgres://extractor_app:extractor_app@localhost:5432/extractor
DATABASE_MIGRATION_URL=postgres://extractor:extractor@localhost:5432/extractor

# Demo user. The password is hashed before it is stored.
DEMO_EMAIL=demo@extractor.local
DEMO_PASSWORD=demo-pass-123

# Signs the session JWT. Not a user password. At least 32 characters.
AUTH_SECRET=dev-only-auth-secret-change-me-0000

# mock runs without a key. anthropic requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
